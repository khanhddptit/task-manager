# Generate a private value with: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=

# Set to true only when serving over HTTPS (required in production).
SESSION_COOKIE_SECURE=false

# Optional Google OAuth. Register this exact callback URL in Google Cloud Console.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://127.0.0.1:5000/auth/google/callback

# Optional invitation and password-reset email. Configure the same SMTP settings for both.
PUBLIC_APP_URL=http://127.0.0.1:5000
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_USE_TLS=true
SMTP_USE_SSL=false
